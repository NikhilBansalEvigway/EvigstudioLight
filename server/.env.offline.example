# EvigStudio OFFLINE profile
# Use this when your machine has no Internet access, but can reach an on-prem/LAN
# LLM Orchestrator that exposes an OpenAI-compatible API under /v1.

# PostgreSQL only — compose overrides this when running in Docker.
DATABASE_URL=postgresql://evigstudio:evigstudio@127.0.0.1:5434/evigstudio

JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3001
NODE_ENV=production

# --- Upstream LLM routing ---
LLM_PROVIDER=orchestrator

# Point this at your orchestrator base URL (must serve /v1/models, /v1/chat/completions, etc.)
# Examples:
# LLM_ORCHESTRATOR_URL=http://host.docker.internal:4000
# LLM_ORCHESTRATOR_URL=http://192.168.1.10:4000
LLM_ORCHESTRATOR_URL=http://host.docker.internal:4000

# Queue control (defaults to enabled for orchestrator)
LLM_ENABLE_QUEUE=
LLM_MAX_CONCURRENT=6
LLM_QUEUE_WAIT_MS=120000
LLM_UPSTREAM_TIMEOUT_MS=0
LLM_REQUIRE_AUTH=false

# App URLs (optional, used for links and OpenRouter headers; safe to set even offline)
APP_HOST=127.0.0.1
APP_URL=http://127.0.0.1
PUBLIC_APP_URL=http://127.0.0.1
