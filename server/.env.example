# PostgreSQL only — never use file: or sqlite URLs here.
# If server/data/*.db appears, nothing in the API reads it — safe to delete the file/folder.
# If Docker maps host port 5433 → container 5432, use :5433 below.
# Docker Compose (repo root): use the stack in docker-compose.yml — DATABASE_URL is set there for the api
# service. For local npm dev without Docker, point at Postgres on the host (example port 5434):
DATABASE_URL=postgresql://evigstudio:evigstudio@127.0.0.1:5434/evigstudio
JWT_SECRET=change-me-to-a-long-random-string-in-production
PORT=3001
NODE_ENV=development

# --- Forgot password (self-service, no email) ---
# POST /api/auth/self-reset-password updates the DB immediately from the /forgot-password page (email + new password).
# Suitable for trusted LANs only — not proof of identity. No SMTP or reset links.

# Optional: absolute path to Vite dist/ to serve UI on the same port as API
STATIC_ROOT=

# --- Upstream LLM routing ---
# Keep the browser Base URL at /api/llm/v1.
# The server-side proxy chooses the actual upstream based on LLM_PROVIDER.
# Valid values: orchestrator | lmstudio | openrouter
LLM_PROVIDER=lmstudio

# Generic override for any OpenAI-compatible upstream. Usually leave blank and
# use the provider-specific URL below instead.
LLM_UPSTREAM_URL=

# Direct LM Studio mode
LM_STUDIO_URL=http://127.0.0.1:1234

# Queued/orchestrator mode
LLM_ORCHESTRATOR_URL=http://127.0.0.1:4000

# OpenRouter mode
OPENROUTER_URL=https://openrouter.ai/api
LLM_UPSTREAM_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://your-app-host
OPENROUTER_APP_NAME=EvigStudio

# Queue control
# Leave blank for provider defaults (on for orchestrator, off otherwise).
LLM_ENABLE_QUEUE=
# Max parallel upstream LLM requests (tune with LM Studio + GPU capacity; ~20 LAN users often use 4–8).
LLM_MAX_CONCURRENT=6
# How long to wait in queue for a slot before HTTP 503 (milliseconds).
LLM_QUEUE_WAIT_MS=120000
# Upstream request timeout for each proxied call (0 = no AbortSignal timeout; streaming may run long).
LLM_UPSTREAM_TIMEOUT_MS=0
# If true, only signed-in team users may use /api/llm (session cookie; still fully offline).
LLM_REQUIRE_AUTH=false

# --- Local disk mirror (Firefox / browsers without showDirectoryPicker) ---
# When set, each Save from an upload-backed workspace is also written under this path on the machine
# that runs the API: <LOCAL_WORKSPACE_MIRROR_ROOT>/<workspace-label>/<relative-path>
# Docker: bind-mount your real project or a staging folder here.
# LOCAL_WORKSPACE_MIRROR_ROOT=/data/workspace-mirror
# Optional shared secret — if set, paste the same value in the Files tab (server disk sync) in each browser.
# If unset, only signed-in users may mirror (session cookie).
# LOCAL_WORKSPACE_MIRROR_TOKEN=
